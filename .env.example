# Local-first inference. Three seats run a model the local Ollama daemon
# serves from its own weights; the Builder runs a different local model
# because its work is tool calls, and the local dolphin tags don't report
# `tools`. No API key or ollama.com credentials are required out of the box.
#
# Default seats:
#   Architect  -> ollama     hf.co/mradermacher/dolphin-2.9.1-yi-1.5-9b-GGUF:Q4_K_M
#                                                  (leading authority; sets
#                                                  direction, rules on results)
#   Planner    -> ollama     hf.co/mradermacher/dolphin-2.9.1-yi-1.5-9b-GGUF:Q4_K_M
#                                                  (structural planning)
#   Researcher -> ollama     hf.co/mradermacher/dolphin-2.9.1-yi-1.5-9b-GGUF:Q4_K_M
#                                                  (knowledge gathering)
#   Builder    -> ollama     qwen3.8:latest       (code implementation;
#                                                  the only local tag with
#                                                  tool support)

# Optional. No seat uses Anthropic by default; set this only if you point one
# at a Claude model below. A seat on Anthropic without a working key silently
# falls back to a canned stub, and the console shows a NO KEY chip for it.
# ANTHROPIC_API_KEY=sk-ant-...

# The Ollama daemon holds the ollama.com credentials for `:cloud` tags, so no
# key is needed here. Only set this if the daemon is not on the default port.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Where the console listens -----------------------------------------------
# Loopback only, by default. The console runs goals and the Builder runs
# programs, so an address other machines can reach is a shell for them. Set
# 0.0.0.0 only behind something you trust -- a bridged container publishing its
# port to the host's loopback, say. Either way the console refuses a request
# made by a page on another site (its Origin), and on loopback one whose Host
# is not loopback (DNS rebinding); curl and scripts, which send no Origin, are
# unaffected.
# CONSOLE_HOST=127.0.0.1
# PORT=8080

# --- Optional per-seat overrides -------------------------------------------
# These win over the defaults above. A provider-wide ANTHROPIC_MODEL or
# OLLAMA_MODEL deliberately does NOT apply to seats: the four seats run four
# different models on purpose. Override a seat here, or from the console.
# ARCHITECT_PROVIDER=ollama
# ARCHITECT_MODEL=hf.co/mradermacher/dolphin-2.9.1-yi-1.5-9b-GGUF:Q4_K_M
# PLANNER_PROVIDER=ollama
# PLANNER_MODEL=hf.co/mradermacher/dolphin-2.9.1-yi-1.5-9b-GGUF:Q4_K_M
# RESEARCHER_PROVIDER=ollama
# RESEARCHER_MODEL=hf.co/mradermacher/dolphin-2.9.1-yi-1.5-9b-GGUF:Q4_K_M
# BUILDER_PROVIDER=ollama
# BUILDER_MODEL=qwen3.8:latest

# --- Thinking ---------------------------------------------------------------
# Each seat card has a thinking checkbox, switched from the console and kept
# until the server restarts. It starts unticked, and the flag is sent either
# way, so an unticked seat is told not to think rather than left to its model's
# own default (which is *on* for the qwen seats). THINKING_BUDGET_TOKENS caps thinking
# on Claude models before 4.6 (Haiku 4.5 among them), the only way those can
# be told to think; newer Claude models and Ollama tags pace it themselves.
# Thinking tokens are spent inside LLM_TIMEOUT_SECONDS, so keep it modest.
# THINKING_BUDGET_TOKENS=4096

# --- Timeouts ---------------------------------------------------------------
# Three nested limits, each catching what the one inside it cannot.
# LLM_TIMEOUT_SECONDS bounds a single provider call at the socket, so it fires
# on a connection that goes quiet. NODE_DEADLINE_SECONDS bounds one agent's
# whole turn -- Architect, Planner and Researcher -- which is what catches a
# model that streams slowly forever or a node making several calls that each
# finish just inside their own limit.
# RUN_BUDGET_SECONDS (serve.py) bounds the run, but only between graph
# supersteps -- it cannot end a node that is still in flight, which is why the
# other two exist.
# The Builder gets its own, larger allowance: it legitimately makes many calls
# per turn. VERIFY_RESERVE_SECONDS is held back from its tool loop so the
# verification pass always gets to run -- files it never executed come back as
# NOT RUN and block approval, so starving that pass costs a cycle.
# MAX_BUILDER_TOOL_TURNS caps how many think-and-call rounds the Builder
# gets. It is a count, not a clock: raising the deadline alone buys nothing
# once the cap is what stops the pass. A broad goal wants both raised, or
# the Builder is cut off mid-task every cycle and the gate never sees
# finished work to approve.
# TERMINAL_TIMEOUT_SECONDS bounds one `terminal_execute` command. A command
# killed here is reported as a timeout, not a failure, but a seat reading the
# report still has to tell them apart -- so keep it above what this repo's own
# scripts take (verify_and_test.py runs ~33s) or working code is handed back
# labelled broken. TERMINAL_TIMEOUT_MAX_SECONDS caps what the Builder may
# request: a tool call is never abandoned, so an unbounded request hangs the
# pass rather than overrunning a deadline.
# The four set below are the values the console is run with, and a fresh .env
# starts from them; the code defaults are 240, 60, 8 and 300.
# LLM_TIMEOUT_SECONDS=120
# NODE_DEADLINE_SECONDS=150
BUILDER_DEADLINE_SECONDS=720
VERIFY_RESERVE_SECONDS=180
MAX_BUILDER_TOOL_TURNS=24
# TERMINAL_TIMEOUT_SECONDS=60
# TERMINAL_TIMEOUT_MAX_SECONDS=600
RUN_BUDGET_SECONDS=900

# --- How much research reaches the Builder ----------------------------------
# Retrieval is careful and expensive -- dense recall, a BM25 re-rank, a
# relevance floor -- and all of it is wasted if the passage it picks is cut
# down before the Builder reads it. RESEARCH_RESULTS feeds the search's
# top_k as well as the slice that is forwarded, so the two cannot drift
# apart. RESEARCH_SNIPPET_CHARS caps each passage; 1500 clears this
# corpus's p99 chunk (1,373 chars), so a passage normally arrives whole and
# the cap only guards against a pathological one. A cut that does bite says
# so in the text.
# RESEARCH_RESULTS=5
# RESEARCH_SNIPPET_CHARS=1500

# --- Online research --------------------------------------------------------
# The one place this project reaches the internet. Before a run starts, the
# goal is fanned out into several searches, the pages that come back are read,
# scored against the goal, and the ones that earn a place are written under
# research/web/ and embedded -- and only then does the Architect open.
#
# There is no API key here and there is not meant to be one: results come from
# DuckDuckGo's keyless HTML endpoint. Everything after that -- ranking,
# extraction, selection -- is this project's own code. No account, no quota,
# no per-call charge.
#
# DuckDuckGo answers a handful of quick requests from one address with its bot
# check, so install.sh runs a SearxNG of your own: a rootless podman container
# under your user's systemd (ambiguity-searxng), bound to 127.0.0.1:8888
# (SEARXNG_PORT moves it), with JSON enabled. It adds SEARXNG_URL below once the instance answers, and
# --no-searxng skips all of it. Point SEARXNG_URL at another instance instead
# and the installer checks that one rather than running its own. Still free,
# still keyless.
# SEARXNG_URL=http://127.0.0.1:8888
#
# The phase is per-run opt-in regardless of these: tick 'research online' in
# the console, or pass research_web: true to run_goal. These only bound it
# once a run has asked. WEB_SEARCH_ENABLED=0 is the machine-level off switch.
# WEB_SEARCH_ENABLED=1          # 0 turns the phase off on an offline machine
# WEB_SEARCH_QUERIES=3          # how many searches one goal fans out into
# WEB_QUERY_MAX_CHARS=250       # longest query sent; DuckDuckGo refuses ~500+
# WEB_RESULTS_PER_QUERY=10
# WEB_FETCH_LIMIT=12            # pages actually fetched, after rank fusion
# WEB_SEARCH_MAX_RESULTS=8      # pages allowed into the corpus per goal
# WEB_SELECT_RATIO=0.25         # keep pages scoring >= this share of the best
# WEB_SEARCH_TIMEOUT_SECONDS=20
# WEB_FETCH_TIMEOUT_SECONDS=20
# WEB_RESEARCH_BUDGET_SECONDS=120
# WEB_FETCH_WORKERS=4

# --- PostgreSQL ---------------------------------------------------------------
# install.sh runs the development database Omarchy's own installer does
# (omarchy-install-docker-dbs): postgres:18 in Docker as the container
# postgres18, published on 127.0.0.1:5432 only, restarting with the daemon, and
# with trust authentication -- no password, which is why it never leaves
# loopback. It enables docker.service so the database is up after a reboot,
# adds you to the docker group (passwordless root; --no-docker-group keeps
# Omarchy's sudo default), and adds DATABASE_URL below once a query has gone
# through it. --no-postgres skips all of it. Point DATABASE_URL at another
# server instead and the installer checks that one rather than running its own.
#
# Nothing in the app reads it -- the corpus is Chroma, under knowledge/. The
# console exports .env to everything it runs, so a script the Builder writes
# and runs finds the database here.
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres

# --- The corpus a run searches ----------------------------------------------
# The corpus is researched archive data only: pages online research fetched
# (research/web/), documents you uploaded (uploads/), and generated projects
# you opted in (projects/<name>). This checkout is never walked or embedded, so
# a fresh install has no corpus until you research or upload something.
# Every run, and the console coming up, re-reads whatever changed in those
# places and prunes whatever left them. A document whose text has not changed
# keeps its vectors, so a rebuild with nothing to do never loads the embedder.
# Turn it off for a machine whose corpus should stay exactly as curated. The
# cost of off is silence: the store stops following the archive on disk, and
# nothing reports it.
# INDEX_PROJECT_BEFORE_RUN=1    # 0 freezes the corpus; nothing else rebuilds it

# --- The embedding model -----------------------------------------------------
# There is exactly one: qwen3-embedding:latest, served by the local Ollama
# daemon and loaded with every layer on the GPU (nothing here runs or needs
# torch). NVIDIA cards below compute capability 7.5 need Ollama's CUDA 12
# build for that, which ./cuda-embed-ollama.sh installs.
# Its tokenizer files come from Hugging Face so the chunker can cut passages
# in-process. A fresh install has no corpus: the first run builds one, and
# measures a relevance floor for it.

# --- Optional cloud provider -----------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# MCP Server URLs (optional - for external MCP integration)
# MCP_GRAPHRAG_URL=http://localhost:8080
# MCP_FILESYSTEM_URL=http://localhost:8081
# MCP_GIT_URL=http://localhost:8082

# LangSmith Tracing (optional - for debugging)
# Uncomment the lines below only if you have a LangSmith API key.
# Leaving tracing enabled without a key will slow or error every run.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=lsv2-...
# LANGCHAIN_PROJECT=langgraph-agent
